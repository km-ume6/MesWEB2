<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MesWEB.ExcelCompare</RootNamespace>
    <Utf8Output>true</Utf8Output>
    
    <!-- Razor Class Library縺ｨ縺励※讒区・ -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MesWEB.Shared\CompareWorksheets.Shared.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Razor Class Library縺ｫ蠢・ｦ√↑繝代ャ繧ｱ繝ｼ繧ｸ -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- RCL 縺ｫ蜷ｫ縺ｾ繧後※縺・ｋ appsettings 繧堤匱陦悟ｯｾ雎｡縺九ｉ髯､螟・-->
    <None Update="appsettings*.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>



